    <!-- DATALINKS NA RAIZ DO FORM -->
    <dataLink fields="{'tokPagAtual', 'tokTotalPags', 'tokPagLabel'}" defaultValues="{'1', '1', 'Pagina 1 / 1'}"/>
    <dataLink fields="{'tokPagAtual'}">
        <event name="onChange"><![CDATA[carregarPaginaTokens();]]></event>
    </dataLink>
    
    <dataLink fields="{'tok_nome_1', 'tok_cat_1', 'tok_url_1'}">
        <event name="onChange"><![CDATA[aoEditarSlotToken(1);]]></event>
    </dataLink>
    <dataLink fields="{'tok_nome_2', 'tok_cat_2', 'tok_url_2'}">
        <event name="onChange"><![CDATA[aoEditarSlotToken(2);]]></event>
    </dataLink>
