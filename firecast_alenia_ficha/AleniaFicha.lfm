local TALENTOS_ITENS = {
    ["marciais"] = {
        { id="marciais_1", cat="marciais", nome="Aparar Relampago", label="Aparar Relampago  [DES 12+, Treinado em Aparar]", prereq="DES 12+, Treinado em Aparar", efeito="1x/rodada, usa sua Reacao para somar +2 na Defesa contra um ataque corpo a corpo." },
        { id="marciais_2", cat="marciais", nome="Riposta Mortal", label="Riposta Mortal  [DES 14+, Especialista em Aparar, Aparar Relampago]", prereq="DES 14+, Especialista em Aparar, Aparar Relampago", efeito="Quando um ataque corpo a corpo contra voce errar apos Aparar Relampago ou Defesa Total, voce desfere imediatamente 1 contra-ataque basico contra o atacante (parte da mesma Reacao)." },
        { id="marciais_3", cat="marciais", nome="Muralha de Aco", label="Muralha de Aco  [FOR 13+, Treinado em Escudos ou Aparar]", prereq="FOR 13+, Treinado em Escudos ou Aparar", efeito="Ao usar Proteger Aliado, cobre ate 2 aliados adjacentes e anula bonus de Flanquear contra eles." },
        { id="marciais_4", cat="marciais", nome="Bastiao Inquebravel", label="Bastiao Inquebravel  [FOR 15+, CON 14+, Especialista em Escudos, Muralha de Aco]", prereq="FOR 15+, CON 14+, Especialista em Escudos, Muralha de Aco", efeito="Quando absorve golpe pelo aliado em Proteger Aliado ou mantem Defesa Total com escudo, reduz o dano desse impacto em [Mod. FOR + Mod. CON] (min. 2, bloqueio ativo - nao e RD passiva) e ignora Empurrar ou Derrubar." },
        { id="marciais_5", cat="marciais", nome="Golpe Preciso", label="Golpe Preciso  [FOR 13+ ou DES 13+, Treinado em Armas Brancas ou Distancia]", prereq="FOR 13+ ou DES 13+, Treinado em Armas Brancas ou Distancia", efeito="Reduz em 1 a Margem de Critico de um tipo de arma escolhido (ex.: 19-20 -> 18-20; nao acumula na mesma arma)." },
        { id="marciais_6", cat="marciais", nome="Anatomia Letal", label="Anatomia Letal  [INT 12+ ou SAB 13+, Niv. 6+, Golpe Preciso]", prereq="INT 12+ ou SAB 13+, Niv. 6+, Golpe Preciso", efeito="Em Acertos Criticos com a arma escolhida, reduz em 2 o limiar do Golpe Devastador do alvo ou impoe Sangramento (1d4 PV/turno ate Medicina CD 15)." },
        { id="marciais_7", cat="marciais", nome="Fluxo de Laminas", label="Fluxo de Laminas  [DES 14+, Treinado em Armas Brancas ou Luta Desarmada]", prereq="DES 14+, Treinado em Armas Brancas ou Luta Desarmada", efeito="Reduz em 1 a penalidade -N em Multiplas Acoes (ex.: em 2 acoes subtrai 1 em vez de 2; mantem teto de treino e bonus minimo >= 0)." },
        { id="marciais_8", cat="marciais", nome="Tempestade de Aco", label="Tempestade de Aco  [DES 16+, Patamar Lenda (Niv. 11+), Especialista em Armas Brancas, Fluxo de Laminas]", prereq="DES 16+, Patamar Lenda (Niv. 11+), Especialista em Armas Brancas, Fluxo de Laminas", efeito="Ao usar Multiplas Acoes contra inimigos distintos em alcance, o primeiro ataque em cada alvo diferente recebe +2 no acerto." },
        { id="marciais_9", cat="marciais", nome="Tiro Firme", label="Tiro Firme  [DES 13+, Treinado em Armas a Distancia]", prereq="DES 13+, Treinado em Armas a Distancia", efeito="Ignora cobertura parcial e vento moderado com arcos/bestas; recarrega besta leve como Acao Livre 1x/turno." },
        { id="marciais_10", cat="marciais", nome="Olho de Falcao", label="Olho de Falcao  [DES 15+, SAB 13+, Especialista em Armas a Distancia, Tiro Firme]", prereq="DES 15+, SAB 13+, Especialista em Armas a Distancia, Tiro Firme", efeito="Aumenta em +50% o alcance efetivo de arcos/bestas; se gastar seu Movimento mirando imovel antes de disparar 1 tiro unico, soma +3 no acerto e +1d6 no dano (nao multiplica em critico)." },
        { id="marciais_11", cat="marciais", nome="Quebra-Guarda", label="Quebra-Guarda  [FOR 14+, Treinado em Armas Brancas ou Atletismo]", prereq="FOR 14+, Treinado em Armas Brancas ou Atletismo", efeito="+3 em Derrubar, Empurrar e Agarrar; ao derrubar um oponente com arma pesada ou haste, causa dano igual ao seu Mod. FOR (min. 1)." },
        { id="marciais_12", cat="marciais", nome="Combate de Cais", label="Combate de Cais  [FOR 12+ ou DES 12+]", prereq="FOR 12+ ou DES 12+", efeito="Sem penalidade com armas improvisadas (1d6), +2 contra alvos Caidos ou Agarrados e pode usar Ajudar em combate como distracao suja (alvo testa DES CD 14 ou sofre -2 na proxima Defesa)." },
    },
    ["sobrevivencia"] = {
        { id="sobrevivencia_1", cat="sobrevivencia", nome="Sangue Frio", label="Sangue Frio  [CON 12+ ou SAB 12+]", prereq="CON 12+ ou SAB 12+", efeito="+3 em testes de CON contra Golpe Devastador e em testes de SAB contra medo, panico e horrores sobrenaturais." },
        { id="sobrevivencia_2", cat="sobrevivencia", nome="Vontade de Ferro", label="Vontade de Ferro  [CON 14+, SAB 13+, Niv. 6+, Sangue Frio]", prereq="CON 14+, SAB 13+, Niv. 6+, Sangue Frio", efeito="Exige 4 falhas (em vez de 3) para morrer no estado Moribundo; 1x/Descanso Longo, ignora os efeitos de 1 nivel de Exaustao durante uma cena inteira." },
        { id="sobrevivencia_3", cat="sobrevivencia", nome="Passo Silencioso", label="Passo Silencioso  [DES 13+, Treinado em Furtividade]", prereq="DES 13+, Treinado em Furtividade", efeito="Move-se em velocidade normal (9m) em Furtividade sem penalidade e recebe +2 para ocultar rastros." },
        { id="sobrevivencia_4", cat="sobrevivencia", nome="Fantasma da Bruma", label="Fantasma da Bruma  [DES 15+, Especialista em Furtividade, Passo Silencioso]", prereq="DES 15+, Especialista em Furtividade, Passo Silencioso", efeito="Em penumbra, neblina ou mata densa, pode tentar esconder-se novamente usando o Movimento apos agir (Percepcao oposta); seu primeiro ataque saindo de ocultacao soma +1d6 de dano (nao multiplica em critico)." },
        { id="sobrevivencia_5", cat="sobrevivencia", nome="Lobo do Mar", label="Lobo do Mar  [DES 12+ ou SAB 12+, Treinado em Navegacao ou Acrobacia]", prereq="DES 12+ ou SAB 12+, Treinado em Navegacao ou Acrobacia", efeito="Ignora penalidades de conves instavel, recifes e embarcacoes sob tempestade; +2 em Natacao e Navegacao sob mau tempo." },
        { id="sobrevivencia_6", cat="sobrevivencia", nome="Leme de Tempestade", label="Leme de Tempestade  [SAB 14+, Especialista em Navegacao & Nautica, Lobo do Mar]", prereq="SAB 14+, Especialista em Navegacao & Nautica, Lobo do Mar", efeito="Reduz em 3 a CD de navegacao em recifes/tempestades (Mar dos Corais / Mar Intransponivel) e reduz a metade qualquer avaria no casco sob seu comando." },
        { id="sobrevivencia_7", cat="sobrevivencia", nome="Maos de Cirurgiao", label="Maos de Cirurgiao  [INT 12+ ou SAB 12+, Treinado em Medicina & Cirurgia]", prereq="INT 12+ ou SAB 12+, Treinado em Medicina & Cirurgia", efeito="+3 em Medicina para estabilizar, estancar sangramentos e reduzir pela metade o tempo de recuperacao de Ferimentos Graves." },
        { id="sobrevivencia_8", cat="sobrevivencia", nome="Bisturi de Baldbella", label="Bisturi de Baldbella  [INT 14+, SAB 13+, Especialista em Medicina & Cirurgia, Maos de Cirurgiao]", prereq="INT 14+, SAB 13+, Especialista em Medicina & Cirurgia, Maos de Cirurgiao", efeito="Em Descanso Curto, um aliado tratado por voce recupera +1d6 PV extras e remove 1 veneno leve/sangramento; reduz em 3 a CD de cirurgias extremas (incluindo extracao de toxinas ou parasitas)." },
        { id="sobrevivencia_9", cat="sobrevivencia", nome="Passo de Caravana", label="Passo de Caravana  [CON 13+, Treinado em Sobrevivencia]", prereq="CON 13+, Treinado em Sobrevivencia", efeito="Suporta o dobro do tempo sem agua ou abrigo antes de testar Exaustao e recebe +2 em Sobrevivencia para guiar e abrigar ate 6 companheiros." },
        { id="sobrevivencia_10", cat="sobrevivencia", nome="Cacador de Fronteira", label="Cacador de Fronteira  [SAB 13+, Treinado em Sobrevivencia e Percepcao]", prereq="SAB 13+, Treinado em Sobrevivencia e Percepcao", efeito="Ao examinar rastros por 5 min, descobre direcao, numero aproximado e um habito/vulnerabilidade da presa (arbitrado pelo Mestre), ganhando +2 na Iniciativa se o confronto ocorrer na cena." },
    },
    ["sociais"] = {
        { id="sociais_1", cat="sociais", nome="Voz de Comando", label="Voz de Comando  [CAR 12+]", prereq="CAR 12+", efeito="Como Acao Principal, concede +2 no proximo ataque ou na Defesa (ate seu proximo turno) de ate 4 aliados que possam ouvi-lo." },
        { id="sociais_2", cat="sociais", nome="Estandarte Vivo", label="Estandarte Vivo  [CAR 15+, Niv. 6+, Voz de Comando]", prereq="CAR 15+, Niv. 6+, Voz de Comando", efeito="Sua Voz de Comando alcanca todos os aliados a ate 18m, soma +3 contra medo/horror e, 1x/combate, permite a 1 aliado realizar um Movimento livre (sem Ataque de Oportunidade) ou um novo teste contra medo/paralisia." },
        { id="sociais_3", cat="sociais", nome="Lingua de Prata", label="Lingua de Prata  [CAR 13+, Treinado em Persuasao ou Enganacao]", prereq="CAR 13+, Treinado em Persuasao ou Enganacao", efeito="+2 em Persuasao e Enganacao em audiencias ou negociacoes; 1x/sessao, se falhar em um teste social por 3 ou menos, pode reformular o argumento e rolar novamente (aceitando o 2o resultado)." },
        { id="sociais_4", cat="sociais", nome="Teia de Cortes", label="Teia de Cortes  [CAR 15+, INT 12+, Especialista em Etiqueta ou Persuasao, Lingua de Prata]", prereq="CAR 15+, INT 12+, Especialista em Etiqueta ou Persuasao, Lingua de Prata", efeito="Apos 1h em corte, taverna ou salao mercantil, identifica quem detem o poder real na sala e um conflito oculto entre faccoes locais, ganhando +3 em testes sociais usando essa alavanca na cena." },
        { id="sociais_5", cat="sociais", nome="Mascara de Mil Rostos", label="Mascara de Mil Rostos  [CAR 13+, Treinado em Disfarce e Enganacao]", prereq="CAR 13+, Treinado em Disfarce e Enganacao", efeito="Monta disfarces em metade do tempo, imita sotaques regionais de Alenia sem penalidade e impoe -3 na Percepcao/Intuicao de quem tentar desmascara-lo." },
        { id="sociais_6", cat="sociais", nome="Sussurro de Kalgard", label="Sussurro de Kalgard  [CAR 14+, SAB 13+, Especialista em Enganacao ou Intimidacao, Mascara de Mil Rostos ou Lingua de Prata]", prereq="CAR 14+, SAB 13+, Especialista em Enganacao ou Intimidacao, Mascara de Mil Rostos ou Lingua de Prata", efeito="Apos 10 min de conversa, pode plantar uma suspeita ou boato plausivel (Enganacao/Persuasao vs. Intuicao do alvo); em sucesso, o alvo age com cautela ou desconfianca contra o terceiro citado ate obter prova contraria." },
        { id="sociais_7", cat="sociais", nome="Presenca Aterradora", label="Presenca Aterradora  [CAR 13+ ou FOR 14+, Treinado em Intimidacao]", prereq="CAR 13+ ou FOR 14+, Treinado em Intimidacao", efeito="+2 em Intimidacao; em combate, gasta Acao Principal para intimidar 1 inimigo inteligente a ate 9m (Intimidacao vs. SAB do alvo): em sucesso, o alvo sofre -2 nos ataques por 2 rodadas (1x/alvo/cena)." },
        { id="sociais_8", cat="sociais", nome="Olhar do Arbitro", label="Olhar do Arbitro  [SAB 13+, Treinado em Intuicao]", prereq="SAB 13+, Treinado em Intuicao", efeito="+3 em Intuicao para detectar mentiras, coercao, emboscadas disfarcadas ou influencia emocional anomala; percebe na hora se alguem age sob chantagem ou medo oculto." },
        { id="sociais_9", cat="sociais", nome="Credito de Porto", label="Credito de Porto  [CAR 12+ ou INT 12+, Treinado em Barganha & Comercio]", prereq="CAR 12+ ou INT 12+, Treinado em Barganha & Comercio", efeito="Consegue 15% de desconto em compras comuns e +15% na venda de cargas; em qualquer porto ou rota de caravana, obtem abrigo seguro, barco ou credito modesto (ate 50 PP) sem garantia imediata." },
        { id="sociais_10", cat="sociais", nome="Rede de Informantes", label="Rede de Informantes  [CAR 14+ ou INT 14+, Submundo 1+ ou Status 1+, Credito de Porto ou Lingua de Prata]", prereq="CAR 14+ ou INT 14+, Submundo 1+ ou Status 1+, Credito de Porto ou Lingua de Prata", efeito="1x/aventura (ou ao chegar a uma grande cidade), aciona contatos para obter sem rolagem um mapa de acesso, salvo-conduto discreto, rota de fuga ou dossie basico sobre um NPC (o Mestre define o favor futuro)." },
        { id="sociais_11", cat="sociais", nome="Coracao de Cronista", label="Coracao de Cronista  [CAR 13+]", prereq="CAR 13+", efeito="Durante Descanso Curto ou Longo, suas historias, cantos ou discursos elevam o moral: ate 5 aliados recuperam +1d4 PV extras no Descanso Curto ou ganham +2 no primeiro teste contra medo/Exaustao do dia seguinte." },
    },
    ["mentais"] = {
        { id="mentais_1", cat="mentais", nome="Mente Analitica", label="Mente Analitica  [INT 13+, Treinado em Investigacao]", prereq="INT 13+, Treinado em Investigacao", efeito="+3 em Investigacao e Historia & Lendas para reconstruir cenas, detectar documentos forjados ou estudar ruinas; encontra pistas secundarias em metade do tempo." },
        { id="mentais_2", cat="mentais", nome="Deducao de Campo", label="Deducao de Campo  [INT 15+, SAB 13+, Especialista em Investigacao, Mente Analitica]", prereq="INT 15+, SAB 13+, Especialista em Investigacao, Mente Analitica", efeito="Como Acao Principal em combate (ou 1 min observando antes), testa Investigacao/Intuicao CD 15 contra um inimigo visivel; em sucesso, descobre sua fraqueza (menor Defesa, vulnerabilidade ou RD) e voce + 1 aliado ganham +2 no acerto contra ele por 3 rodadas." },
        { id="mentais_3", cat="mentais", nome="Estrategista de Batalha", label="Estrategista de Batalha  [INT 14+, SAB 12+]", prereq="INT 14+, SAB 12+", efeito="Usa Mod. INT no lugar de Mod. DES na Iniciativa; no inicio do combate, pode trocar sua posicao na ordem de Iniciativa com 1 aliado voluntario que possa ouvi-lo." },
        { id="mentais_4", cat="mentais", nome="Mestre Tatico", label="Mestre Tatico  [INT 16+, Niv. 8+, Estrategista de Batalha]", prereq="INT 16+, Niv. 8+, Estrategista de Batalha", efeito="Ao usar a acao Ajudar em combate, orienta ate 2 aliados a ate 9m por voz (sem precisar ficar adjacente a 1,5m), concedendo +2 a cada um ate seu proximo turno." },
        { id="mentais_5", cat="mentais", nome="Sentidos Agucados", label="Sentidos Agucados  [SAB 13+, Treinado em Percepcao]", prereq="SAB 13+, Treinado em Percepcao", efeito="+3 em Percepcao e +2 fixo na Iniciativa; nao pode ser surpreendido por emboscadas mundanas enquanto estiver consciente e nao incapacitado." },
        { id="mentais_6", cat="mentais", nome="Memoria Enciclopedica", label="Memoria Enciclopedica  [INT 13+]", prereq="INT 13+", efeito="Recorda mapas, brasoes, tratados e dialogos com precisao; +2 em Historia, Geografia, Religiao e Idiomas, e pode realizar testes de conhecimento mesmo em pericias Destreinadas sem penalidade por falta de biblioteca." },
        { id="mentais_7", cat="mentais", nome="Poliglota das Cinco Terras", label="Poliglota das Cinco Terras  [INT 13+, Treinado em Idiomas & Cifras]", prereq="INT 13+, Treinado em Idiomas & Cifras", efeito="Aprende imediatamente 2 idiomas/dialetos ou cifras de Alenia, recebe +3 para decifrar codigos de Kalis e inscricoes de Kelgore/Incognito, e capta o sentido geral de linguas desconhecidas apos breve contato." },
        { id="mentais_8", cat="mentais", nome="Maos de Alquimista", label="Maos de Alquimista  [INT 13+, Treinado em Alquimia & Venenos ou Herbalismo]", prereq="INT 13+, Treinado em Alquimia & Venenos ou Herbalismo", efeito="Reduz em 25% o custo de reagentes e pela metade o tempo de preparo de venenos, antidotos, oleo incendiario e extratos; aumenta em +2 a CD das misturas que voce mesmo preparar." },
        { id="mentais_9", cat="mentais", nome="Engenho de Armadilhas", label="Engenho de Armadilhas  [INT 13+, Treinado em Engenharia & Mecanica]", prereq="INT 13+, Treinado em Engenharia & Mecanica", efeito="+3 para montar ou desarmar armadilhas, fechaduras complexas e mecanismos antigos; em 10 min com materiais de campo, monta armadilha improvisada (alerta, laco que derruba ou estacas de 1d8, Percepcao CD 15 + Mod. INT)." },
        { id="mentais_10", cat="mentais", nome="Mente Blindada", label="Mente Blindada  [SAB 14+]", prereq="SAB 14+", efeito="+3 em testes de SAB contra manipulacao, intimidacao, ilusoes sensoriais, sussurros de Thanatos/Incognito e impulsos psiquicos; 1x/sessao, pode refazer um teste de SAB fracassado contra horror ou coercao." },
        { id="mentais_11", cat="mentais", nome="Vigia dos Ritos Antigos", label="Vigia dos Ritos Antigos  [INT 14+ ou SAB 14+, Fe Verdadeira 1+ ou Dom Antigo 1+, Treinado em Religiao & Ocultismo]", prereq="INT 14+ ou SAB 14+, Fe Verdadeira 1+ ou Dom Antigo 1+, Treinado em Religiao & Ocultismo", efeito="Soma +2 adicional na Preparacao Ritualistica (respeitando o teto de +8), reduz em 1d6 qualquer dano de sacrificio ritual (min. 1) e pressente reliquias de Incognito ou condutores ativos de adamante a ate 18m." },
    },
};

