            <!-- ABA 4: INVENTARIO & SISTEMA MONETARIO -->
            <tab title="Inventario &amp; Moedas">
                <scrollBox align="client">
                    <layout left="0" top="0" width="1056" height="1130">
                        <rectangle left="6" top="6" width="1036" height="196" color="#1B1E26" strokeColor="#9A7E42" strokeSize="1" xradius="6" yradius="6">
                            <!-- Linha 1: Moedas (Padrao Prata) + Cartas de Credito -->
                            <label left="14" top="8" width="160" height="18" text="AUREOS (PO = 10 PP)" fontColor="#D9B96A" fontSize="12" fontStyle="bold"/>
                            <edit left="14" top="28" width="144" height="34" field="moedasOuro" type="number" horzTextAlign="center" fontSize="16"/>

                            <label left="172" top="8" width="180" height="18" text="PRATAS / ESCUDOS (PP)" fontColor="#EAE4D6" fontSize="12" fontStyle="bold"/>
                            <edit left="172" top="28" width="156" height="34" field="moedasPrata" type="number" horzTextAlign="center" fontSize="16"/>

                            <label left="342" top="8" width="180" height="18" text="COBRES / VINTENS (PC)" fontColor="#A6AEBF" fontSize="12" fontStyle="bold"/>
                            <edit left="342" top="28" width="156" height="34" field="moedasCobre" type="number" horzTextAlign="center" fontSize="16"/>

                            <label left="512" top="8" width="210" height="18" text="CARTAS DE CREDITO (PP | 0 kg)" fontColor="#7FC48C" fontSize="12" fontStyle="bold"/>
                            <edit left="512" top="28" width="186" height="34" field="cartasCredito" type="number" horzTextAlign="center" fontSize="16"/>

                            <label left="712" top="8" width="310" height="18" text="REDE BANCARIA / CUNHAGEM" fontColor="#A6AEBF" fontSize="12" fontStyle="bold"/>
                            <comboBox left="712" top="28" width="310" height="34" field="bancoOrigem" fontSize="13"
                                      items="{'Corallis — Cera Azul (5% | Legal)', 'Kalis — Talha Cifrada (8% | Sigilo)', 'Misto (Corallis + Kalis)', 'Sem Conta Bancaria'}"
                                      values="{'corallis', 'kalis', 'misto', 'nenhum'}"/>

                            <!-- Linha 2: Patrimonio, Peso das Moedas e Carga -->
                            <label left="14" top="70" width="240" height="18" text="PATRIMONIO TOTAL (BOLSA + BANCO)" fontColor="#D9B96A" fontSize="11" fontStyle="bold"/>
                            <rectangle left="14" top="90" width="240" height="32" color="#14171E" strokeColor="#343A4A" strokeSize="1" xradius="4" yradius="4">
                                <label align="client" field="patrimonioTotal" fontColor="#D9B96A" fontSize="14" fontStyle="bold" horzTextAlign="center" vertTextAlign="center"/>
                            </rectangle>

                            <label left="268" top="70" width="210" height="18" text="PESO DAS MOEDAS (100 = 1 kg)" fontColor="#A6AEBF" fontSize="11" fontStyle="bold"/>
