                            <comboBox left="124" top="44" width="470" height="36" field="kitSelecionado" items="{'00 - Sem Kit (Livre / Media Padrao)', '01 - Mercenario (1d10)', '02 - Cavaleiro (1d10)', '03 - Soldado / Veterano (1d10)', '04 - Duelista / Esgrimista (1d8)', '05 - Barbaro / Berserker (1d12)', '06 - Guarda-Costas / Sentinela (1d10)', '07 - Arqueiro / Franco-Atirador (1d8)', '08 - Lutador / Pugilista (1d10)', '09 - Ladino (1d6)', '10 - Assassino (1d6)', '11 - Espiao (1d6)', '12 - Contrabandista (1d8)', '13 - Cacador de Recompensas (1d8)', '14 - Charlatao / Vigario (1d6)', '15 - Saqueador de Tumbas (1d8)', '16 - Pirata (1d8)', '17 - Navegador / Marinheiro (1d8)', '18 - Explorador / Cartografo (1d8)', '19 - Patrulheiro / Rastreador (1d8)', '20 - Mercador / Caravaneiro (1d6)', '21 - Domador / Cavaleiro de Estrada (1d8)', '22 - Ferreiro / Armeiro (1d8)', '23 - Alquimista (1d6)', '24 - Medico / Cirurgiao (1d6)', '25 - Erudito / Historiador (1d6)', '26 - Engenheiro / Artifice (1d6)', '27 - Herbalista / Boticario (1d6)', '28 - Astronomo / Sabio (1d6)', '29 - Carpinteiro / Artesao (1d8)', '30 - Nobre (1d6)', '31 - Diplomata / Conselheiro (1d6)', '32 - Bardo / Menestrel (1d6)', '33 - Sacerdote / Clerigo (1d6)', '34 - Inquisidor (1d8)', '35 - Ermitao / Sobrevivente (1d8)', '36 - Tocado pelo Dom Antigo (1d6 | Mestre)'}" values="{'sem_kit', 'mercenario', 'cavaleiro', 'soldado', 'duelista', 'barbaro', 'guarda_costas', 'arqueiro', 'lutador', 'ladino', 'assassino', 'espiao', 'contrabandista', 'cacador_rec', 'charlatao', 'saqueador', 'pirata', 'navegador', 'explorador', 'patrulheiro', 'mercador', 'domador', 'ferreiro', 'alquimista', 'medico', 'erudito', 'engenheiro', 'herbalista', 'astronomo', 'carpinteiro', 'nobre', 'diplomata', 'bardo', 'sacerdote', 'inquisidor', 'ermitao', 'dom_antigo'}" fontSize="14"/>
                            <button left="604" top="44" width="150" height="36" text="Aplicar Kit" fontSize="15">
