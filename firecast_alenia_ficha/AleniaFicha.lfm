local KITS = {
    ["sem_kit"] = { nome="00 - Sem Kit (Livre / Media Padrao)", dv=8, perBase=1, multInt=0.75, espField=nil, espVal=0, pericias={  }, equip="Adaga, roupa de viagem resistente, mochila, cantil, racoes (5 dias) e 25 PP.", hab="Caminho Proprio: Flexibilidade total; comeca com +2 Pontos de Pericia extras no Nivel 1.", pp=25, armDef=0, escDef=0, arma1={ nome="Adaga", attr="destreza", per="per_armas_brancas", dano="1d4", margem="19", mult="2" }, arma2=nil, itens={ { nome="Adaga", tipo="arma", qtd=1, peso=0.5, nota="Dano 1d4+FOR | Crit 19-20/x2 | Leve, Agil, Arremesso 6m" }, { nome="Roupas Comuns de Viagem", tipo="equip", qtd=1, peso=1.5, nota="Tunica grossa, calcas reforcadas e capa simples" }, { nome="Mochila de Couro Reforcado", tipo="equip", qtd=1, peso=1.5, nota="Comporta ate 18 kg de carga" }, { nome="Cantil de Latao ou Barro (1 L)", tipo="equip", qtd=1, peso=0.4, nota="Conserva agua fresca de viagem" }, { nome="Racao Seca de Viagem (Dia)", tipo="cons", qtd=5, peso=0.5, nota="Consome 1 dia de racao seca (sustenta 1 dia sem Exaustao por fome)." } } },
    ["mercenario"] = { nome="01 - Mercenario (1d10)", dv=10, perBase=1, multInt=0.75, espField=nil, espVal=0, pericias={ "per_armas_brancas", "per_aparar", "per_sobrevivencia", "per_intimidacao", "per_barganha" }, equip="Espada longa, couro batido, capa de estrada, pedra de amolar, mochila e 30 PP.", hab="Sobrevivente de Contrato: +2 em Iniciativa e troca de arma como acao livre 1x/turno.", pp=30, armDef=2, escDef=0, arma1={ nome="Espada Longa", attr="forca", per="per_armas_brancas", dano="1d8", margem="19", mult="2" }, arma2=nil, itens={ { nome="Espada Longa", tipo="arma", qtd=1, peso=1.5, nota="Dano 1d8+FOR (1d10 em 2 maos) | Crit 19-20/x2" }, { nome="Couro Batido", tipo="armadura", qtd=1, peso=6.0, nota="Defesa +2 | Penalidade 0 | Zero RD" }, { nome="Capa de Estrada", tipo="equip", qtd=1, peso=1.0, nota="Protege contra vento e chuva leve" }, { nome="Pedra de Amolar", tipo="equip", qtd=1, peso=0.3, nota="Mantem o fio das laminas em campanha" }, { nome="Mochila de Couro Reforcado", tipo="equip", qtd=1, peso=1.5, nota="Comporta ate 18 kg de carga" } } },
    ["cavaleiro"] = { nome="02 - Cavaleiro (1d10)", dv=10, perBase=1, multInt=0.75, espField="esp_status", espVal=1, pericias={ "per_armas_brancas", "per_aparar", "per_escudos", "per_cavalgar", "per_etiqueta" }, equip="Espada longa, escudo medio, cota de malha, tabardo com brasao, sela e 40 PP.", hab="Juramento de Aco: +2 em Cavalgar em combate e +2 na Defesa ao usar Proteger Aliado com escudo.", pp=40, armDef=3, escDef=2, arma1={ nome="Espada Longa", attr="forca", per="per_armas_brancas", dano="1d8", margem="19", mult="2" }, arma2=nil, itens={ { nome="Espada Longa", tipo="arma", qtd=1, peso=1.5, nota="Dano 1d8+FOR (1d10 em 2 maos) | Crit 19-20/x2" }, { nome="Escudo Medio", tipo="armadura", qtd=1, peso=3.5, nota="Escudo Defesa +2 | Penalidade -1" }, { nome="Cota de Malha", tipo="armadura", qtd=1, peso=12.0, nota="Defesa +3 | Penalidade -2 | Zero RD" }, { nome="Tabardo com Brasao", tipo="equip", qtd=1, peso=0.6, nota="Identifica linhagem, ordem ou casa nobre" }, { nome="Sela, Freio & Estribos", tipo="equip", qtd=1, peso=7.0, nota="Equipamento completo para montaria" } } },
    ["soldado"] = { nome="03 - Soldado / Veterano (1d10)", dv=10, perBase=1, multInt=0.5, espField=nil, espVal=0, pericias={ "per_armas_brancas", "per_escudos", "per_aparar", "per_atletismo", "per_percepcao" }, equip="Lanca de infantaria, espada curta, escudo medio, cota de malha, cantil e 20 PP.", hab="Linha de Frente: Quando adjacente a um aliado, ambos ganham +1 na Defesa corpo a corpo.", pp=20, armDef=3, escDef=2, arma1={ nome="Lanca de Infantaria", attr="forca", per="per_armas_brancas", dano="1d8", margem="20", mult="3" }, arma2={ nome="Espada Curta", attr="forca", per="per_armas_brancas", dano="1d6", margem="19", mult="2" }, itens={ { nome="Lanca de Infantaria", tipo="arma", qtd=1, peso=2.0, nota="Dano 1d8+FOR | Crit 20/x3 | Versatil/Alcance" }, { nome="Espada Curta", tipo="arma", qtd=1, peso=1.0, nota="Dano 1d6+FOR | Crit 19-20/x2 | Leve" }, { nome="Escudo Medio", tipo="armadura", qtd=1, peso=3.5, nota="Escudo Defesa +2 | Penalidade -1" }, { nome="Cota de Malha", tipo="armadura", qtd=1, peso=12.0, nota="Defesa +3 | Penalidade -2 | Zero RD" }, { nome="Cantil de Latao ou Barro (1 L)", tipo="equip", qtd=1, peso=0.4, nota="Agua de marcha militar" } } },
    ["duelista"] = { nome="04 - Duelista / Esgrimista (1d8)", dv=8, perBase=1, multInt=0.75, espField=nil, espVal=0, pericias={ "per_armas_brancas", "per_aparar", "per_esquiva", "per_acrobacia", "per_intuicao" }, equip="Florete (ou lamina oriental), adaga de aparar, gibao reforcado fino e 35 PP.", hab="Cadencia Letal: Em duelos 1x1, reduz em 1 a penalidade adicional de Multiplas Acoes (min. 0).", pp=35, armDef=1, escDef=0, arma1={ nome="Florete", attr="destreza", per="per_armas_brancas", dano="1d6", margem="18", mult="2" }, arma2={ nome="Adaga de Aparar", attr="destreza", per="per_armas_brancas", dano="1d4", margem="19", mult="2" }, itens={ { nome="Florete", tipo="arma", qtd=1, peso=1.0, nota="Dano 1d6+FOR | Crit 18-20/x2 | Agil (DES), Perfurante" }, { nome="Adaga de Aparar", tipo="arma", qtd=1, peso=0.5, nota="Dano 1d4+FOR | Crit 19-20/x2 | Auxilia aparar em duelo" }, { nome="Gibao Reforcado Fino", tipo="armadura", qtd=1, peso=4.0, nota="Defesa +1 | Penalidade 0 | Zero RD | Discreto" } } },
    ["barbaro"] = { nome="05 - Barbaro / Berserker (1d12)", dv=12, perBase=1, multInt=0.5, espField=nil, espVal=0, pericias={ "per_armas_brancas", "per_atletismo", "per_sobrevivencia", "per_intimidacao", "per_escalada" }, equip="Machado grande, peles reforcadas (Def +1), trofeu de caca, cantil e 15 PP.", hab="Furia Indomavel: 1x/combate por 3 rodadas: +2 dano corpo a corpo e +3 CON vs Golpe Devastador (-2 Defesa).", pp=15, armDef=1, escDef=0, arma1={ nome="Machado Grande", attr="forca", per="per_armas_brancas", dano="1d12", margem="20", mult="3" }, arma2=nil, itens={ { nome="Machado Grande", tipo="arma", qtd=1, peso=3.5, nota="Dano 1d12+FOR | Crit 20/x3 | Duas maos, Pesada" }, { nome="Peles Reforcadas", tipo="armadura", qtd=1, peso=4.0, nota="Defesa +1 | Zero RD | Protecao contra frio" }, { nome="Trofeu de Caca", tipo="equip", qtd=1, peso=0.5, nota="Marca de bravura tribal" }, { nome="Cantil de Couro", tipo="equip", qtd=1, peso=0.3, nota="Odre resistente de viagem" } } },
    ["guarda_costas"] = { nome="06 - Guarda-Costas / Sentinela (1d10)", dv=10, perBase=1, multInt=0.5, espField=nil, espVal=0, pericias={ "per_armas_brancas", "per_aparar", "per_escudos", "per_percepcao", "per_intuicao" }, equip="Espada longa, escudo torre, brigantina, lanterna de vigia, apito e 25 PP.", hab="Escudo Vivo: Ao usar Proteger Aliado, impoe -2 extra no atacante e pode mover 3m como reacao.", pp=25, armDef=4, escDef=3, arma1={ nome="Espada Longa", attr="forca", per="per_armas_brancas", dano="1d8", margem="19", mult="2" }, arma2=nil, itens={ { nome="Espada Longa", tipo="arma", qtd=1, peso=1.5, nota="Dano 1d8+FOR | Crit 19-20/x2" }, { nome="Escudo Torre", tipo="armadura", qtd=1, peso=8.0, nota="Escudo Defesa +3 | Penalidade -3 | +2 em Proteger Aliado" }, { nome="Brigantina / Meia-Placa", tipo="armadura", qtd=1, peso=16.0, nota="Defesa +4 | Penalidade -3 | Zero RD" }, { nome="Lanterna Comum de Ferro", tipo="equip", qtd=1, peso=1.0, nota="Ilumina 9m (+6m penumbra) em vigilia" }, { nome="Apito de Osso ou Latao", tipo="equip", qtd=1, peso=0.1, nota="Sinal sonoro de alerta ate 250m" } } },
    ["arqueiro"] = { nome="07 - Arqueiro / Franco-Atirador (1d8)", dv=8, perBase=1, multInt=0.75, espField=nil, espVal=0, pericias={ "per_armas_dist", "per_esquiva", "per_furtividade", "per_percepcao", "per_sobrevivencia" }, equip="Arco longo (30 flechas), adaga, couro batido, capa camuflada e 25 PP.", hab="Olho de Falcao: Gastando Movimento para mirar parado, ganha +2 no acerto e -1 na Margem de Critico.", pp=25, armDef=2, escDef=0, arma1={ nome="Arco Longo", attr="destreza", per="per_armas_dist", dano="1d8", margem="20", mult="3" }, arma2={ nome="Adaga", attr="destreza", per="per_armas_brancas", dano="1d4", margem="19", mult="2" }, itens={ { nome="Arco Longo", tipo="arma", qtd=1, peso=1.5, nota="Dano 1d8 | Crit 20/x3 | 2 maos, Alcance 45m (sem +FOR)" }, { nome="Flecha (Aljava)", tipo="cons", qtd=30, peso=0.03, nota="Dispara 1 flecha de arco longo." }, { nome="Adaga", tipo="arma", qtd=1, peso=0.5, nota="Dano 1d4+FOR | Crit 19-20/x2 | Defesa proxima" }, { nome="Couro Batido", tipo="armadura", qtd=1, peso=6.0, nota="Defesa +2 | Penalidade 0 | Zero RD" }, { nome="Capa Camuflada", tipo="equip", qtd=1, peso=1.0, nota="Ajuda a ocultar silhueta em matas e rochas" } } },
    ["lutador"] = { nome="08 - Lutador / Pugilista (1d10)", dv=10, perBase=1, multInt=0.5, espField=nil, espVal=0, pericias={ "per_luta_desarm", "per_esquiva", "per_atletismo", "per_acrobacia", "per_intimidacao" }, equip="Bandagens reforcadas/soqueiras de couro, gibao reforcado, unguento e 20 PP.", hab="Punhos de Ferro: Dano desarmado 1d6+FOR, pode aparar golpes leves e ganha +3 para agarrar/derrubar.", pp=20, armDef=1, escDef=0, arma1={ nome="Punhos de Ferro (Desarmado)", attr="forca", per="per_luta_desarm", dano="1d6", margem="20", mult="2" }, arma2=nil, itens={ { nome="Bandagens & Soqueiras de Couro", tipo="equip", qtd=1, peso=0.4, nota="Protegem os punhos em combate desarmado (1d6+FOR)" }, { nome="Gibao Reforcado", tipo="armadura", qtd=1, peso=4.0, nota="Defesa +1 | Penalidade 0 | Zero RD" }, { nome="Cataplasma de Ervas", tipo="cons", qtd=1, peso=0.2, nota="Aplicado no Descanso Curto/Longo: soma +1d4 PV extras na recuperacao." } } },
    ["ladino"] = { nome="09 - Ladino (1d6)", dv=6, perBase=2, multInt=1.0, espField=nil, espVal=0, pericias={ "per_furtividade", "per_ladinagem", "per_esquiva", "per_percepcao", "per_prestidig", "per_acrobacia" }, equip="2 adagas, espada curta, couro batido escuro, gazuas, corda fina (15m) e 25 PP.", hab="Golpe Oportunista: +1d6 dano contra desprevenidos ou flanqueados (+2d6 Lenda, +3d6 Epico; nao multiplica no critico).", pp=25, armDef=2, escDef=0, arma1={ nome="Espada Curta", attr="destreza", per="per_armas_brancas", dano="1d6", margem="19", mult="2" }, arma2={ nome="Adaga", attr="destreza", per="per_armas_brancas", dano="1d4", margem="19", mult="2" }, itens={ { nome="Adaga", tipo="arma", qtd=2, peso=0.5, nota="Dano 1d4+FOR | Crit 19-20/x2 | Leve, Agil, Arremesso 6m" }, { nome="Espada Curta", tipo="arma", qtd=1, peso=1.0, nota="Dano 1d6+FOR | Crit 19-20/x2 | Leve, Agil" }, { nome="Couro Batido Escuro", tipo="armadura", qtd=1, peso=6.0, nota="Defesa +2 | Penalidade 0 | Zero RD" }, { nome="Jogo de Gazuas Comum", tipo="equip", qtd=1, peso=0.4, nota="Ferramenta base para Ladinagem e Fechaduras" }, { nome="Corda de Seda Trancada (15m)", tipo="equip", qtd=1, peso=2.0, nota="Suporta 450 kg | +1 em Escalada" } } },
    ["assassino"] = { nome="10 - Assassino (1d6)", dv=6, perBase=2, multInt=0.75, espField="esp_submundo", espVal=1, pericias={ "per_armas_brancas", "per_furtividade", "per_alquimia", "per_disfarce", "per_esquiva" }, equip="Adaga estilizada, espada curta, capa com capuz, 2 doses veneno fraco, kit disfarce e 30 PP.", hab="Ponto Vital: Contra alvo surpreso, reduz Margem de Critico em 1 e impoe -2 no teste de CON vs Golpe Devastador.", pp=30, armDef=0, escDef=0, arma1={ nome="Adaga Estilizada", attr="destreza", per="per_armas_brancas", dano="1d4", margem="19", mult="2" }, arma2={ nome="Espada Curta", attr="destreza", per="per_armas_brancas", dano="1d6", margem="19", mult="2" }, itens={ { nome="Adaga Estilizada", tipo="arma", qtd=1, peso=0.5, nota="Dano 1d4+FOR | Crit 19-20/x2 | Agil, discreta" }, { nome="Espada Curta", tipo="arma", qtd=1, peso=1.0, nota="Dano 1d6+FOR | Crit 19-20/x2 | Agil" }, { nome="Capa com Capuz", tipo="equip", qtd=1, peso=0.8, nota="Oculta feicoes e armas sob a sombra" }, { nome="Veneno Fraco (Dose)", tipo="cons", qtd=2, peso=0.1, nota="Aplica veneno na lamina (CON CD 14 ou +1d6 dano venenoso)." }, { nome="Estojo de Disfarce & Maquiagem", tipo="equip", qtd=1, peso=1.5, nota="Permite alterar rosto, voz e identidade" } } },
    ["espiao"] = { nome="11 - Espiao (1d6)", dv=6, perBase=2, multInt=1.0, espField="esp_submundo", espVal=1, pericias={ "per_disfarce", "per_enganacao", "per_investigacao", "per_intuicao", "per_idiomas", "per_furtividade" }, equip="Adaga oculta, kit de disfarce, tintas invisiveis, vestes de 2 estratos e 40 PP.", hab="Rede de Sussurros: Apos 24h na cidade (5 PP em subornos), localiza informante e ganha +3 para apurar segredos.", pp=40, armDef=0, escDef=0, arma1={ nome="Adaga Oculta", attr="destreza", per="per_armas_brancas", dano="1d4", margem="19", mult="2" }, arma2=nil, itens={ { nome="Adaga Oculta", tipo="arma", qtd=1, peso=0.4, nota="Dano 1d4+FOR | Crit 19-20/x2 | Escondida sob a manga/bota" }, { nome="Estojo de Disfarce & Maquiagem", tipo="equip", qtd=1, peso=1.5, nota="Habilita testes complexos de Disfarce" }, { nome="Tinta Invisivel (Dose)", tipo="cons", qtd=5, peso=0.04, nota="Escreve mensagem secreta revelada apenas sobre chama de vela." }, { nome="Vestes de 2 Estratos Sociais", tipo="equip", qtd=2, peso=1.5, nota="Traje comum e traje fino para infiltracao" } } },
    ["contrabandista"] = { nome="12 - Contrabandista (1d8)", dv=8, perBase=2, multInt=0.75, espField="esp_submundo", espVal=1, pericias={ "per_barganha", "per_enganacao", "per_navegacao", "per_furtividade", "per_esquiva" }, equip="Sabre curto, besta leve, capa com bolsos falsos, bau de fundo duplo, mapas e 35 PP.", hab="Passagem Oculta: +3 para esconder cargas em revistas, subornar guardas ou achar saidas discretas.", pp=35, armDef=0, escDef=0, arma1={ nome="Sabre Curto", attr="destreza", per="per_armas_brancas", dano="1d6", margem="18", mult="2" }, arma2={ nome="Besta Leve", attr="destreza", per="per_armas_dist", dano="1d8", margem="19", mult="2" }, itens={ { nome="Sabre Curto", tipo="arma", qtd=1, peso=1.1, nota="Dano 1d6+FOR | Crit 18-20/x2 | Agil (DES)" }, { nome="Besta Leve", tipo="arma", qtd=1, peso=2.5, nota="Dano 1d8 | Crit 19-20/x2 | Recarga (Movimento)" }, { nome="Virote de Besta", tipo="cons", qtd=15, peso=0.04, nota="Dispara 1 virote de besta leve." }, { nome="Capa com Bolsos Falsos", tipo="equip", qtd=1, peso=1.0, nota="Oculta pacotes pequenos em revistas" }, { nome="Cartas & Mapas de Rotas", tipo="equip", qtd=1, peso=0.3, nota="Mapeia enseadas, portos e passagens discretas" } } },
    ["cacador_rec"] = { nome="13 - Cacador de Recompensas (1d8)", dv=8, perBase=1, multInt=0.75, espField=nil, espVal=0, pericias={ "per_armas_dist", "per_sobrevivencia", "per_investigacao", "per_intimidacao", "per_percepcao" }, equip="Besta leve (20 virotes), espada curta, algemas, rede de captura, couro batido e 25 PP.", hab="Presa Marcada: Estudando pistas de 1 alvo por 1h, recebe +2 para rastrea-lo e +1 em ataques contra ele.", pp=25, armDef=2, escDef=0, arma1={ nome="Besta Leve", attr="destreza", per="per_armas_dist", dano="1d8", margem="19", mult="2" }, arma2={ nome="Espada Curta", attr="forca", per="per_armas_brancas", dano="1d6", margem="19", mult="2" }, itens={ { nome="Besta Leve", tipo="arma", qtd=1, peso=2.5, nota="Dano 1d8 | Crit 19-20/x2 | Recarga (Movimento)" }, { nome="Virote de Besta", tipo="cons", qtd=20, peso=0.04, nota="Dispara 1 virote de besta leve." }, { nome="Espada Curta", tipo="arma", qtd=1, peso=1.0, nota="Dano 1d6+FOR | Crit 19-20/x2" }, { nome="Algemas de Ferro com Chave", tipo="equip", qtd=1, peso=1.2, nota="Prendem pulsos (Ladinagem CD 16 / FOR CD 20)" }, { nome="Rede de Captura", tipo="equip", qtd=1, peso=2.0, nota="Imobiliza alvos vivos sem matar" }, { nome="Couro Batido", tipo="armadura", qtd=1, peso=6.0, nota="Defesa +2 | Penalidade 0 | Zero RD" } } },
    ["charlatao"] = { nome="14 - Charlatao / Vigario (1d6)", dv=6, perBase=2, multInt=1.0, espField=nil, espVal=0, pericias={ "per_enganacao", "per_persuasao", "per_prestidig", "per_disfarce", "per_etiqueta", "per_intuicao" }, equip="Adaga escondida, documentos falsos, selos de cera, dados viciados, roupas finas e 40 PP.", hab="Lingua de Prata: 1x por cena social, re-rola um teste falho de Enganacao ou Persuasao.", pp=40, armDef=0, escDef=0, arma1={ nome="Adaga Escondida", attr="destreza", per="per_armas_brancas", dano="1d4", margem="19", mult="2" }, arma2=nil, itens={ { nome="Adaga Escondida", tipo="arma", qtd=1, peso=0.4, nota="Dano 1d4+FOR | Crit 19-20/x2" }, { nome="Documentos Falsos", tipo="equip", qtd=1, peso=0.2, nota="Salvo-condutos e cartas de apresentacao forjadas" }, { nome="Bastao de Lacre & Selo", tipo="cons", qtd=5, peso=0.06, nota="Sela carta ou documento com cera quente." }, { nome="Dados Viciados", tipo="equip", qtd=1, peso=0.1, nota="+3 em apostas de taverna (Percepcao CD 18 nota)" }, { nome="Traje Fino de Corte", tipo="equip", qtd=1, peso=2.0, nota="Abre portas em saloes e casas mercantis" } } },
    ["saqueador"] = { nome="15 - Saqueador de Tumbas (1d8)", dv=8, perBase=2, multInt=0.75, espField=nil, espVal=0, pericias={ "per_ladinagem", "per_escalada", "per_investigacao", "per_historia", "per_percepcao" }, equip="Espada curta, pe-de-cabra, lanterna blindada, gazuas, corda 20m com arpeu, giz e 20 PP.", hab="Instinto de Ruina: +3 em Percepcao e Esquiva contra armadilhas mecanicas e desabamentos.", pp=20, armDef=0, escDef=0, arma1={ nome="Espada Curta", attr="destreza", per="per_armas_brancas", dano="1d6", margem="19", mult="2" }, arma2=nil, itens={ { nome="Espada Curta", tipo="arma", qtd=1, peso=1.0, nota="Dano 1d6+FOR | Crit 19-20/x2" }, { nome="Pe-de-Cabra de Aco", tipo="equip", qtd=1, peso=2.2, nota="+2 em FOR/Atletismo para arrombar portas e tampas" }, { nome="Lanterna Blindada (Furta-Fogo)", tipo="equip", qtd=1, peso=1.2, nota="Fecha luz em Acao Livre ou foca feixe de 15m" }, { nome="Jogo de Gazuas Comum", tipo="equip", qtd=1, peso=0.4, nota="Abre fechaduras e desarma armadilhas" }, { nome="Corda com Arpeu (20m)", tipo="equip", qtd=1, peso=6.0, nota="Escalada em ruinas, muralhas e pocos" }, { nome="Giz & Po Fino (Porcao)", tipo="cons", qtd=10, peso=0.03, nota="Marca caminhos em ruinas ou detecta correntes de ar/armadilhas." } } },
