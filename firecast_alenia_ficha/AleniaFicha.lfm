                        <!-- CARD EMPORIO AUTOMATICO (COMPRA DIRETA -> DESCONTA MOEDAS + GUARDA NO INVENTARIO + SOMA PESO) -->
                        <rectangle left="6" top="210" width="1036" height="142" color="#1B1E26" strokeColor="#9A7E42" strokeSize="2" xradius="6" yradius="6">
                            <label left="14" top="8" width="540" height="22" text="EMPORIO AUTOMATICO DE ALENIA (TOMO IX + ARMAS &amp; ARMADURAS)" fontColor="#D9B96A" fontSize="14" fontStyle="bold"/>
                            <checkBox left="568" top="7" width="260" height="24" field="emporioUsarBanco" text="Usar Cartas de Credito se faltar bolsa" fontColor="#7FC48C" fontSize="12"/>
                            <label left="834" top="8" width="188" height="22" text="155 itens • Debito automatico" fontColor="#A6AEBF" fontSize="11" horzTextAlign="trailing" vertTextAlign="center"/>

                            <label left="14" top="34" width="320" height="16" text="CATEGORIA DO CATALOGO" fontColor="#A6AEBF" fontSize="11" fontStyle="bold"/>
                            <comboBox name="cmbEmporioCat" left="14" top="52" width="322" height="34" field="emporioCat" fontSize="13"
                                      items="{'01 - Pacotes Prontos de Expedicao (~10% desc.)', '02 - Mochilas, Recipientes &amp; Transporte', '03 - Acampamento, Fogo &amp; Iluminacao', '04 - Sobrevivencia, Exploracao &amp; Escalada', '05 - Pesca, Caca &amp; Armadilhas', '06 - Forja, Ferraria, Carpintaria &amp; Oficios', '07 - Medicina, Herbalismo &amp; Alquimia', '08 - Nautica, Navegacao &amp; Cartografia', '09 - Subterfugio, Investigacao &amp; Corte', '10 - Vestuario, Clima &amp; Provisoes', '11 - Montarias, Animais de Carga &amp; Arreios', '12 - Armas Comuns (Livro de Regras)', '13 - Armaduras &amp; Escudos (Defesa | Zero RD)'}" values="{'pacotes', 'mochilas', 'acampamento', 'sobrevivencia', 'pesca_caca', 'forja_oficios', 'alquimia_med', 'nautica', 'subterfugio', 'vestuario', 'montarias', 'armas', 'armaduras'}">
                                <event name="onChange"><![CDATA[_formRef = self; atualizarItensEmporio(self, true);]]></event>
                            </comboBox>

                            <label left="346" top="34" width="380" height="16" text="ITEM / PACOTE (PRECO E PESO)" fontColor="#A6AEBF" fontSize="11" fontStyle="bold"/>
