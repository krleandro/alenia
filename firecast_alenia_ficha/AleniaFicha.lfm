                                      items="{'Aparar Relampago  [DES 12+, Treinado em Aparar]', 'Riposta Mortal  [DES 14+, Especialista em Aparar, Aparar Relampago]', 'Muralha de Aco  [FOR 13+, Treinado em Escudos ou Aparar]', 'Bastiao Inquebravel  [FOR 15+, CON 14+, Especialista em Escudos, Muralha de Aco]', 'Golpe Preciso  [FOR 13+ ou DES 13+, Treinado em Armas Brancas ou Distancia]', 'Anatomia Letal  [INT 12+ ou SAB 13+, Niv. 6+, Golpe Preciso]', 'Fluxo de Laminas  [DES 14+, Treinado em Armas Brancas ou Luta Desarmada]', 'Tempestade de Aco  [DES 16+, Patamar Lenda (Niv. 11+), Especialista em Armas Brancas, Fluxo de Laminas]', 'Tiro Firme  [DES 13+, Treinado em Armas a Distancia]', 'Olho de Falcao  [DES 15+, SAB 13+, Especialista em Armas a Distancia, Tiro Firme]', 'Quebra-Guarda  [FOR 14+, Treinado em Armas Brancas ou Atletismo]', 'Combate de Cais  [FOR 12+ ou DES 12+]'}" values="{'marciais_1', 'marciais_2', 'marciais_3', 'marciais_4', 'marciais_5', 'marciais_6', 'marciais_7', 'marciais_8', 'marciais_9', 'marciais_10', 'marciais_11', 'marciais_12'}">
