                    <event name="onClick"><![CDATA[rolarD20("Atributo INTELIGENCIA", getMod("inteligencia"), "");]]></event>
                </button>
            </rectangle>
            <rectangle left="692" top="54" width="160" height="126" color="#212530" strokeColor="#9A7E42" strokeSize="1" xradius="6" yradius="6">
                <label left="6" top="6" width="148" height="22" text="SABEDORIA" fontColor="#D9B96A" fontSize="14" fontStyle="bold" horzTextAlign="center"/>
