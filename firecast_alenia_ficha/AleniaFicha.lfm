    ["guarda_costas"] = { nome="06 - Guarda-Costas / Sentinela (1d10)", dv=10, perBase=1, multInt=0.5, espField=nil, espVal=0, pericias={ "per_armas_brancas", "per_aparar", "per_escudos", "per_percepcao", "per_intuicao" }, equip="Espada longa, escudo torre, brigantina, lanterna de vigia, apito e 25 PP.", hab="Escudo Vivo: Ao usar Proteger Aliado, impoe -2 extra no atacante e pode mover 3m como reacao." },
    ["arqueiro"] = { nome="07 - Arqueiro / Franco-Atirador (1d8)", dv=8, perBase=1, multInt=0.75, espField=nil, espVal=0, pericias={ "per_armas_dist", "per_esquiva", "per_furtividade", "per_percepcao", "per_sobrevivencia" }, equip="Arco longo (30 flechas), adaga, couro batido, capa camuflada e 25 PP.", hab="Olho de Falcao: Gastando Movimento para mirar parado, ganha +2 no acerto e -1 na Margem de Critico." },
    ["lutador"] = { nome="08 - Lutador / Pugilista (1d10)", dv=10, perBase=1, multInt=0.5, espField=nil, espVal=0, pericias={ "per_luta_desarm", "per_esquiva", "per_atletismo", "per_acrobacia", "per_intimidacao" }, equip="Bandagens reforcadas/soqueiras de couro, gibao reforcado, unguento e 20 PP.", hab="Punhos de Ferro: Dano desarmado 1d6+FOR, pode aparar golpes leves e ganha +3 para agarrar/derrubar." },
